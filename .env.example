# Auth.js session secret. Generate one with `openssl rand -base64 32`.
AUTH_SECRET=****

# Google OAuth client ID (Google Cloud console, web application client).
AUTH_GOOGLE_ID=****

# Google OAuth client secret for the same client.
AUTH_GOOGLE_SECRET=****

# Base Groq API key. It joins student-contributed keys in the shared pool.
GROQ_API_KEY=****

# Base64-encoded 32-byte key for encrypting contributed provider keys.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=****

# Postgres connection string. Production: Able's own Supabase project, pooled (transaction) URL. Local: postgres://postgres:postgres@localhost:5433/able
POSTGRES_URL=****

# Comma-separated Google emails allowed to open /admin.
ADMIN_EMAILS=admin@example.com

# UPI ID that receives payments; it goes into the payment QR code.
UPI_ID=yourname@bank

# Payee name shown in UPI apps when a student scans the QR code.
UPI_PAYEE_NAME=Able

# Support email shown on the pricing and contact pages.
SUPPORT_EMAIL=support@example.com

# Secret that protects the /api/cron/reminders endpoint.
CRON_SECRET=****

# Public base URL of the app, used for absolute links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Resend API key; emails are sent only when this is set.
RESEND_API_KEY=****

# Optional: sender address for emails, for example "Able <no-reply@yourdomain.com>".
EMAIL_FROM=****

# Optional: Redis for rate limits, resumable streams and shared-key cooldowns.
REDIS_URL=****

# Optional: local model (e.g. Qwen2.5-VL served by llama.cpp on the LAN). When
# set, it becomes the preferred chat engine, with the Groq/Gemini pool as an
# automatic fallback. Leave unset to behave exactly as before.
# LOCAL_MODEL_URL=http://192.168.1.20:8080/v1
# LOCAL_MODEL_ID=local
# LOCAL_MODEL_VISION=true            # false for a text-only local model
# NEXT_PUBLIC_LOCAL_VISION=true      # browser mirror, so the composer offers images

# Optional: isolated localhost database ending in _test. The test launcher
# derives localhost /able_test from POSTGRES_URL when omitted.
# TEST_POSTGRES_URL=postgres://postgres:postgres@localhost:5433/able_test

# Use pnpm dev:local for the no-login localhost workspace (live with a Groq
# key), or pnpm dev:preview for sample responses. These flags are set by the
# launcher; do not enable ABLE_MOCK_AI on a real deployment.
