# Auth.js session secret. Generate one with `openssl rand -base64 32`.
AUTH_SECRET=****

# Google OAuth client ID (Google Cloud console, web application client).
AUTH_GOOGLE_ID=****

# Google OAuth client secret for the same client.
AUTH_GOOGLE_SECRET=****

# Groq API key used for every model call.
GROQ_API_KEY=****

# Postgres connection string. Neon's pooled URL in production; local: postgres://postgres:postgres@localhost:5433/able
POSTGRES_URL=****

# Comma-separated Google emails allowed to open /admin.
ADMIN_EMAILS=admin@example.com

# UPI ID that receives payments; it goes into the payment QR code.
UPI_ID=yourname@bank

# Payee name shown in UPI apps when a student scans the QR code.
UPI_PAYEE_NAME=Able

# Support email shown on the pricing and contact pages.
SUPPORT_EMAIL=support@example.com

# Secret that protects the /api/cron/reminders endpoint.
CRON_SECRET=****

# Public base URL of the app, used for absolute links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Resend API key; emails are sent only when this is set.
RESEND_API_KEY=****

# Optional: sender address for emails, for example "Able <no-reply@yourdomain.com>".
EMAIL_FROM=****

# Optional: Redis for the template's rate limits and resumable streams.
REDIS_URL=****
